# MongoDB 容器只绑定本机；如需局域网访问，请同时配置认证和防火墙白名单。
MONGO_BIND_IP=127.0.0.1
MONGO_PORT=27019
MONGO_DATABASE=weixin

# setup 动作会自动生成真实密码写入被 Git 忽略的 .env.mongo。
MONGO_ROOT_USERNAME=mongo_root
MONGO_ROOT_PASSWORD=请运行_mongodb.bat_setup_自动生成
MONGO_APP_USERNAME=wechat_rpa
MONGO_APP_PASSWORD=请运行_mongodb.bat_setup_自动生成

# 宿主机接收 API。Windows 虚拟机需要访问时将绑定地址改为宿主机内网地址
# 或 0.0.0.0，并通过防火墙仅允许采集虚拟机 IP。
CONTROL_API_BIND_IP=127.0.0.1
CONTROL_API_PORT=8020
CONTROL_API_TOKEN=请运行_mongodb.bat_setup_自动生成
